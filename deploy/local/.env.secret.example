# 로컬 개발 env — scripts/local-dev-up.sh 가 이 파일을 복사해 deploy/local/.env.secret 을 만든다(커밋 금지).
# __GENERATE__ 자리는 스크립트가 무작위 값으로 채운다. 직접 만들 때는 openssl rand -hex 32 등으로 채운다.
# 값에 따옴표를 쓰지 않는다(스크립트가 KEY=VALUE 를 그대로 읽는다).

# PostgreSQL 16 (컨테이너 vs-local-dev-postgres, 5442)
VS_DB_URL=jdbc:postgresql://localhost:5442/vs
VS_DB_USER=vs
VS_DB_PASSWORD=__GENERATE__

# JWT 서명키 — 32바이트 이상
VS_JWT_SIGNING_KEY=__GENERATE__

# Redis 7 (컨테이너 vs-local-dev-redis, 6389). 운영은 ElastiCache 엔드포인트 · VS_REDIS_SSL=true · AUTH 토큰
VS_REDIS_HOST=localhost
VS_REDIS_PORT=6389
VS_REDIS_SSL=false
VS_REDIS_PASSWORD=
VS_REDIS_KEY_PREFIX=vs:

# 세션 · 휴면 (ISO-8601). 무활동 만료 시험은 VS_AUTH_IDLE_TIMEOUT=PT2M · VS_AUTH_WARN_BEFORE=PT1M 처럼 줄인다
VS_AUTH_IDLE_TIMEOUT=PT30M
VS_AUTH_ABSOLUTE_TIMEOUT=PT12H
VS_AUTH_WARN_BEFORE=PT5M
VS_AUTH_DORMANT_AFTER=P6M

# 로컬 구현체 — local 프로필에서만 유효. 운영은 pass · standard
VS_IDENTITY_VERIFIER=local
VS_PII_CIPHER=plain

# 화면 주소 — 채널 불일치 안내(redirectUrl)와 본인인증 콜백 postMessage 대상 origin
VS_ADMIN_URL=http://localhost:5320
VS_COMP_URL=http://localhost:5320
