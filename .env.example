# 프론트 env 예시 — 복사해서 .env.local 로 쓴다(.env.local 은 커밋하지 않는다).
# VITE_API_BASE 가 있으면 실제 로그인(API), 없으면 지금 목업 로그인(GitHub Pages 빌드).
# 로컬: npm run dev 가 /api 를 http://localhost:8090 (make dev-api) 으로 프록시한다.
VITE_API_BASE=/api

# 세션 만료 예고 시점(초). 비우면 서버 GET /api/auth/session 의 warnBeforeSec, 그것도 없으면 300
# VITE_SESSION_WARN_SEC=300
